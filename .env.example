# ---- CompShopper server configuration (copy to .env or export in your shell) ----

# Port for the API / web server when running with `npm start` (default 3001)
PORT=3001

# Host port to publish when running with docker compose (container always listens on 3001)
COMPSHOPPER_PORT=3001

# Seconds to keep a search result cached before hitting retailers again (default 300).
# "Refresh prices" in the UI always bypasses the cache.
CACHE_TTL_SECONDS=300

# Per-retailer request timeout and overall search timeout, in milliseconds.
SOURCE_TIMEOUT_MS=12000
SEARCH_TIMEOUT_MS=25000

# Optional: route retailer requests through an HTTP(S) proxy (e.g. a residential
# proxy service) to reduce bot blocking. HTTPS_PROXY / HTTP_PROXY are honoured too.
# SCRAPER_PROXY_URL=http://user:pass@proxy.example.com:8080

# Official APIs (recommended: far more reliable than HTML scraping)
# Best Buy Developer API key: https://developer.bestbuy.com/
# BESTBUY_API_KEY=
# eBay Browse API (client credentials): https://developer.ebay.com/
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# Micro Center prices are per store. Store id from the site's store selector (default 029 = Tustin, CA).
# MICROCENTER_STORE_ID=029

# Turn individual retailers off
# COMPSHOPPER_DISABLE_NEWEGG=1
# COMPSHOPPER_DISABLE_EBAY=1
# COMPSHOPPER_DISABLE_BESTBUY=1
# COMPSHOPPER_DISABLE_WALMART=1
# COMPSHOPPER_DISABLE_MICROCENTER=1

# Fabricated sample listings for UI testing without network access (never use in production)
# COMPSHOPPER_DEMO=1
